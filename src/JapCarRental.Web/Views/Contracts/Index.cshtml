@using JapCarRental.Web.Services
@model JapCarRental.Web.ViewModels.ContractIndexViewModel

@{
    ViewData["Title"] = "Contratos";
    // Not called "page": @page is a reserved Razor directive.
    var paged = Model.Contracts;
    var filtering = !string.IsNullOrEmpty(Model.Search)
                    || Model.Status.HasValue || Model.From.HasValue || Model.To.HasValue;

    // Dates travel in the URL as yyyy-MM-dd: it is unambiguous and it is what <input type="date"> uses.
    var from = Model.From?.ToString("yyyy-MM-dd");
    var to = Model.To?.ToString("yyyy-MM-dd");

    // Plates are stored without separators (AA11BB); the dashes are only a display choice.
    static string ShowPlate(string plate) =>
        plate.Length == 6 ? $"{plate[..2]}-{plate[2..4]}-{plate[4..]}" : plate;

    static string StatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Upcoming => "status-upcoming",
        ContractStatus.Active => "status-busy",
        ContractStatus.Finished => "status-done",
        _ => "status-cancelled"
    };
}

<div class="jr-page-head">
    <div>
        <h1 class="jr-title">Contratos</h1>
        <p class="jr-subtitle">
            @(filtering ? $"{paged.TotalItems} resultados" : $"{Model.TotalContracts} registados")
        </p>
    </div>
    <a asp-action="Create" class="jr-btn jr-btn-primary">Novo contrato</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="jr-alert jr-alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="jr-alert jr-alert-error" role="alert">@error</div>
}

@if (Model.TotalContracts == 0)
{
    <div class="jr-empty">
        <p>Ainda não há contratos. Crie o primeiro para alugar um veículo a um cliente.</p>
        <a asp-action="Create" class="jr-btn jr-btn-primary">Criar contrato</a>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="jr-search" role="search"
          data-live-search data-target="#results">
        <div class="jr-search-box">
            <input type="search" name="search" value="@Model.Search" class="jr-input"
                   placeholder="Pesquisar por cliente, veículo ou matrícula"
                   aria-label="Pesquisar contratos" autocomplete="off" />
            <button type="submit" class="jr-btn jr-btn-primary">Pesquisar</button>
        </div>

        <div class="jr-filters">
            <div class="jr-filter">
                <label for="status">Estado</label>
                <select id="status" name="status" class="jr-input">
                    <option value="">Todos</option>
                    @foreach (var s in Enum.GetValues<ContractStatus>())
                    {
                        <option value="@s" selected="@(Model.Status == s)">@Html.DisplayFor(_ => s)</option>
                    }
                </select>
            </div>
            <div class="jr-filter">
                <label for="from">De</label>
                <input id="from" type="date" name="from" value="@from" max="@to" class="jr-input" />
            </div>
            <div class="jr-filter">
                <label for="to">Até</label>
                <input id="to" type="date" name="to" value="@to" min="@from" class="jr-input" />
                <span class="field-validation-error">@Html.ValidationMessage("to")</span>
            </div>
            <a asp-action="Index" class="jr-btn jr-btn-quiet">Limpar filtros</a>
        </div>
    </form>

    <div id="results" aria-live="polite">
        @if (paged.Items.Count == 0)
        {
            <div class="jr-empty">
                <p>Nenhum contrato corresponde à pesquisa ou aos filtros escolhidos.</p>
            </div>
        }
        else
        {
            <div class="jr-table-wrap">
                <table class="jr-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Veículo</th>
                            <th>Período</th>
                            <th>Km iniciais</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in paged.Items)
                    {
                        <tr>
                            <td class="jr-vehicle-name">@c.CustomerName</td>
                            <td>
                                <div>@c.VehicleName</div>
                                <span class="plate"><span class="plate-eu">P</span><span class="plate-text">@ShowPlate(c.LicensePlate)</span></span>
                            </td>
                            <td>@c.StartDate.ToString("dd/MM/yyyy") a @c.EndDate.ToString("dd/MM/yyyy")</td>
                            <td>@c.InitialMileage</td>
                            <td>
                                @* Status is calculated from the dates and the cancellation, never stored. *@
                                <span class="status @StatusClass(c.Status)">@Html.DisplayFor(_ => c.Status)</span>
                            </td>
                            <td>
                                <div class="jr-actions">
                                    @* Only contracts that have not started can be edited or cancelled. *@
                                    @if (c.Status == ContractStatus.Upcoming)
                                    {
                                        <a asp-action="Edit" asp-route-id="@c.Id" class="jr-btn jr-btn-quiet jr-btn-sm">Editar</a>
                                        <form asp-action="Cancel" asp-route-id="@c.Id" method="post"
                                              data-confirm="Cancelar este contrato? Fica no histórico como cancelado.">
                                            <button type="submit" class="jr-btn jr-btn-danger jr-btn-sm">Cancelar</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <nav class="jr-pager" aria-label="Paginação">
                <span>A mostrar @paged.FirstItem a @paged.LastItem de @paged.TotalItems</span>
                <div class="jr-pager-nav">
                    @* Every link keeps the search and the filters, so changing page never loses them. *@
                    @if (paged.HasPrevious)
                    {
                        <a asp-action="Index" asp-route-page="@(paged.Page - 1)" asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status" asp-route-from="@from" asp-route-to="@to"
                           class="jr-btn jr-btn-quiet jr-btn-sm">Anterior</a>
                    }
                    else
                    {
                        <span class="jr-btn jr-btn-quiet jr-btn-sm is-disabled" aria-disabled="true">Anterior</span>
                    }

                    <span>Página @paged.Page de @paged.TotalPages</span>

                    @if (paged.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(paged.Page + 1)" asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status" asp-route-from="@from" asp-route-to="@to"
                           class="jr-btn jr-btn-quiet jr-btn-sm">Seguinte</a>
                    }
                    else
                    {
                        <span class="jr-btn jr-btn-quiet jr-btn-sm is-disabled" aria-disabled="true">Seguinte</span>
                    }
                </div>
            </nav>
        }
    </div>
}

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}
