@model JapCarRental.Web.ViewModels.CustomerIndexViewModel

@{
    ViewData["Title"] = "Clientes";
    // Not called "page": @page is a reserved Razor directive.
    var paged = Model.Customers;
    var searching = !string.IsNullOrEmpty(Model.Search);
}

<div class="jr-page-head">
    <div>
        <h1 class="jr-title">Clientes</h1>
        <p class="jr-subtitle">
            @(searching ? $"{paged.TotalItems} resultados" : $"{Model.TotalCustomers} registados")
        </p>
    </div>
    <a asp-action="Create" class="jr-btn jr-btn-primary">Novo cliente</a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="jr-alert jr-alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="jr-alert jr-alert-error" role="alert">@error</div>
}
@if (Model.TotalCustomers == 0)
{
    <div class="jr-empty">
        <p>Ainda não há clientes. Adicione o primeiro para poder criar contratos.</p>
        <a asp-action="Create" class="jr-btn jr-btn-primary">Adicionar cliente</a>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="jr-search" role="search"
          data-live-search data-target="#results">
        <div class="jr-search-box">
            <input type="search" name="search" value="@Model.Search" class="jr-input"
                   placeholder="Pesquisar por nome, email, telefone ou carta"
                   aria-label="Pesquisar clientes" autocomplete="off" />
            <button type="submit" class="jr-btn jr-btn-primary">Pesquisar</button>
        </div>
    </form>

    @* Only this area is replaced while typing. *@
    <div id="results" aria-live="polite">
        @if (paged.Items.Count == 0)
        {
            <div class="jr-empty">
                <p>Nenhum cliente corresponde a "@Model.Search". Tente outro nome, email ou telefone.</p>
            </div>
        }
        else
        {
            <div class="jr-table-wrap">
                <table class="jr-table">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Carta</th>
                            <th>Contratos</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in paged.Items)
                    {
                        <tr>
                            <td class="jr-vehicle-name">@c.FullName</td>
                            <td>@c.Email</td>
                            <td>@c.PhoneNumber</td>
                            <td>@c.DrivingLicenseNumber</td>
                            <td>@c.ContractCount</td>
                            <td>
                                <div class="jr-actions">
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="jr-btn jr-btn-quiet jr-btn-sm">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                          data-confirm="Remover este cliente?">
                                        <button type="submit" class="jr-btn jr-btn-danger jr-btn-sm">Remover</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <nav class="jr-pager" aria-label="Paginação">
                <span>A mostrar @paged.FirstItem a @paged.LastItem de @paged.TotalItems</span>
                <div class="jr-pager-nav">
                    @if (paged.HasPrevious)
                    {
                        <a asp-action="Index" asp-route-page="@(paged.Page - 1)" asp-route-search="@Model.Search"
                           class="jr-btn jr-btn-quiet jr-btn-sm">Anterior</a>
                    }
                    else
                    {
                        <span class="jr-btn jr-btn-quiet jr-btn-sm is-disabled" aria-disabled="true">Anterior</span>
                    }

                    <span>Página @paged.Page de @paged.TotalPages</span>

                    @if (paged.HasNext)
                    {
                        <a asp-action="Index" asp-route-page="@(paged.Page + 1)" asp-route-search="@Model.Search"
                           class="jr-btn jr-btn-quiet jr-btn-sm">Seguinte</a>
                    }
                    else
                    {
                        <span class="jr-btn jr-btn-quiet jr-btn-sm is-disabled" aria-disabled="true">Seguinte</span>
                    }
                </div>
            </nav>
        }
    </div>
}

@section Scripts {
    <script src="~/js/live-search.js" asp-append-version="true"></script>
}